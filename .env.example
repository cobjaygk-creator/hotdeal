# Copy to Railway Variables (do not commit real credentials).
# Residential or Korea-exit HTTP/SOCKS5 proxy for community buy links.
# Example: http://user:pass@host:port
# Example: socks5://user:pass@host:port
PPOMPPU_PROXY_URL=
PPOMPPU_ENRICH_INTERVAL_MINUTES=5
PPOMPPU_ENRICH_BATCH=12

# FMKorea headless-browser gate solver (Playwright Chromium).
# 1 = on (default). Set 0 to disable and let fmkorea stay blocked.
FMKOREA_BROWSER_ENABLED=1
# Also run fmkorea *detail* pages through the browser when blocked. Off by
# default — detail enrich fires often and browser loads burn proxy GB.
FMKOREA_BROWSER_DETAIL=0
# Min seconds between headless fetches (proxy-GB guard).
FMKOREA_BROWSER_MIN_GAP_SEC=45
# Proxy for the fmkorea browser; falls back to PPOMPPU_PROXY_URL.
# Strongly prefer a STICKY-SESSION endpoint so one page load stays on one exit
# IP — put {session} where the provider takes a session id, e.g.
#   http://USER-session-{session}:PASS@gate.provider.com:7000
FMKOREA_PROXY_URL=
# How long (seconds) to keep one sticky-session token before rotating it.
FMKOREA_PROXY_SESSION_TTL_SEC=480
# Optional Amazon Associates JP tag for 일마존 buy links.
AMAZON_JP_ASSOCIATE_TAG=

# Naver OAuth login (developers.naver.com). Callback: {SITE_URL}/auth/naver/callback
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# Google Analytics measurement ID (e.g. G-XXXXXXX). Empty = gtag not inserted.
GA_MEASUREMENT_ID=
